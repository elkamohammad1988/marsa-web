# Copy to .env.local and adjust for your environment.
# The site runs with zero configuration; each block below upgrades one part of
# it from "works locally" to "production real".

# Canonical site origin (used for metadata, canonical URLs, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://www.marsa.money

# Where "Log in" sends users (the banking app). Falls back to /get-started.
# NEXT_PUBLIC_APP_URL=https://app.marsa.money

# Contact addresses shown on the site.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@marsa.money
# NEXT_PUBLIC_SALES_EMAIL=sales@marsa.money
# NEXT_PUBLIC_PRESS_EMAIL=press@marsa.money

# Social profiles (footer).
# NEXT_PUBLIC_SOCIAL_X=https://x.com/marsamoney
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@marsamoney
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/marsamoney

# --- Regulatory disclosure --------------------------------------------------
# LEGAL: the site claims an authorisation ONLY when both of these are set, and
# they must match a real entry on the regulator's public register. Leave them
# empty until that is true; the copy then describes the licensed-partner model
# instead.
# NEXT_PUBLIC_REGULATOR_AUTHORITY=De Nederlandsche Bank
# NEXT_PUBLIC_REGULATOR_REFERENCE=R123456

# --- Database (production storage) ------------------------------------------
# Set both to store form submissions in PostgreSQL instead of local files.
# Works with Supabase or any PostgREST endpoint. Apply db/schema.sql once first.
# The service-role key bypasses row-level security: server-side only, never
# expose it to the browser and never prefix it with NEXT_PUBLIC_.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Directory for the fallback file store (dev, and if the database is down).
# DATA_DIR=.data

# --- Admin area (/admin) ----------------------------------------------------
# Both are required, otherwise /admin stays closed. Use a long random secret,
# e.g. `openssl rand -hex 32`.
# ADMIN_PASSWORD=change-me-to-something-long
# ADMIN_SESSION_SECRET=64-hex-characters-of-randomness

# Optional share token for /demo/stats?token=... (funnel view without an admin
# login). Leave unset to restrict /demo/stats to logged-in admins only.
# DEMO_STATS_TOKEN=some-long-random-token

# --- Email notifications via Resend (optional) ------------------------------
# When RESEND_API_KEY *and* RESEND_FROM are set, each new submission is emailed
# after it has been stored. Delivery failures are logged, never fatal — the
# record is always retrievable from /admin.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Marsa <noreply@marsa.money>   # must be a Resend-verified sender
# RESEND_TO=team@marsa.money                # defaults to NEXT_PUBLIC_SUPPORT_EMAIL

# Override the FX data provider base URL if needed.
# FX_API_BASE=https://api.frankfurter.dev/v1
